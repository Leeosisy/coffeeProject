.calendar {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 24rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(111, 78, 55, 0.1);
}

.calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.nav-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #6f4e37;
  border-radius: 50%;
}

.nav-btn:active {
  background: #f7f3ef;
}

.month-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  background: #e8dfd6;
}

.month-picker:active {
  background: #ddd4c9;
}

.month-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3d2b1f;
}

.picker-arrow {
  margin-left: 10rpx;
  font-size: 32rpx;
  color: #9a8b7e;
  line-height: 1;
}

.week-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: 12rpx;
}

.week-day {
  text-align: center;
  font-size: 24rpx;
  color: #9a8b7e;
  line-height: 48rpx;
}

.days-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  row-gap: 12rpx;
}

.day-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
}

.day-inner {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.day-num {
  font-size: 34rpx;
  color: #3d2b1f;
  line-height: 1;
}

.day-inner.other-month .day-num {
  color: #d4ccc4;
}

.day-inner.selected {
  background: linear-gradient(135deg, #6f4e37 0%, #8b6347 100%);
}

.day-inner.selected .day-num {
  color: #ffffff;
  font-weight: 600;
}

.day-inner.today .day-num {
  color: #6f4e37;
  font-weight: 600;
}

.today-dot {
  position: absolute;
  bottom: 10rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #6f4e37;
}
