<view class="calendar">
  <view class="calendar-header">
    <view class="nav-btn" bindtap="onPrevMonth">‹</view>
    <picker
      mode="date"
      fields="month"
      start="1970-01"
      end="2099-12"
      value="{{pickerValue}}"
      bindchange="onMonthChange"
    >
      <view class="month-picker">
        <text class="month-title">{{year}}年{{month}}月</text>
        <text class="picker-arrow">▾</text>
      </view>
    </picker>
    <view class="nav-btn" bindtap="onNextMonth">›</view>
  </view>

  <view class="week-row">
    <text wx:for="{{weekDays}}" wx:key="*this" class="week-day">{{item}}</text>
  </view>

  <view class="days-grid">
    <view
      wx:for="{{days}}"
      wx:key="date"
      class="day-cell"
      data-date="{{item.date}}"
      bindtap="onSelectDay"
    >
      <view class="day-inner {{item.isSelected ? 'selected' : ''}} {{item.isCurrentMonth ? '' : 'other-month'}} {{item.isToday && !item.isSelected ? 'today' : ''}} {{item.hasRecord && !item.isSelected ? 'has-record' : ''}}">
        <text class="day-num">{{item.day}}</text>
        <view wx:if="{{item.isToday && !item.isSelected}}" class="today-dot"></view>
      </view>
    </view>
  </view>
</view>
