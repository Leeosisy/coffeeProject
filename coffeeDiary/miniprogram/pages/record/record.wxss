.page {
  min-height: 100vh;
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #f7f3ef;
  box-sizing: border-box;
}

.date-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(111, 78, 55, 0.06);
}

.date-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-width: 0;
}

.date-label {
  font-size: 28rpx;
  color: #9a8b7e;
}

.date-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #3d2b1f;
}

.delete-btn {
  flex-shrink: 0;
  margin-left: 24rpx;
  padding: 10rpx 24rpx;
  font-size: 26rpx;
  color: #c45c26;
  background: rgba(196, 92, 38, 0.08);
  border-radius: 12rpx;
}

.delete-btn:active {
  opacity: 0.7;
}

.form-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 12rpx 32rpx 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(111, 78, 55, 0.08);
}

.field {
  padding-top: 28rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #6f4e37;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.required {
  color: #c45c26;
}

.input {
  height: 80rpx;
  padding: 0 24rpx;
  background: #f7f3ef;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #3d2b1f;
}

.brand-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
  padding: 16rpx 24rpx;
  background: #f7f3ef;
  border-radius: 16rpx;
}

.brand-picker:active {
  opacity: 0.85;
}

.brand-picker-main {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}

.brand-picker-logo {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: #ffffff;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.brand-picker-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6f4e37;
  font-size: 24rpx;
  font-weight: 600;
}

.brand-picker-text {
  font-size: 28rpx;
  color: #3d2b1f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.brand-picker-text.placeholder {
  color: #b5a89c;
}

.brand-picker-arrow {
  margin-left: 12rpx;
  font-size: 36rpx;
  color: #c4b8ad;
  line-height: 1;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: #f7f3ef;
  font-size: 26rpx;
  color: #6f4e37;
}

.chip.active {
  background: #6f4e37;
  color: #ffffff;
}

.rating-row {
  display: flex;
  gap: 12rpx;
}

.star {
  font-size: 48rpx;
  color: #ddd2c8;
  line-height: 1;
}

.star.on {
  color: #c45c26;
}

.image-area {
  width: 220rpx;
  height: 220rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #f7f3ef;
}

.preview {
  width: 100%;
  height: 100%;
}

.image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.plus {
  font-size: 48rpx;
  color: #b5a89c;
  line-height: 1;
}

.hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #b5a89c;
}

.clear-image {
  display: inline-block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9a8b7e;
}

.save-btn {
  margin-top: 40rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #6f4e37 0%, #8b6347 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.save-btn::after {
  border: none;
}

.save-btn[disabled] {
  opacity: 0.7;
}

.loading-page {
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-text {
  font-size: 28rpx;
  color: #9a8b7e;
}
