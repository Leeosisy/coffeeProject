<!--record.wxml-->
<view class="page" wx:if="{{!loading}}">
  <view class="date-bar">
    <view class="date-info">
      <text class="date-label">记录日期</text>
      <text class="date-value">{{recordDate}}</text>
    </view>
    <text wx:if="{{isEdit}}" class="delete-btn" bindtap="onDelete">删除</text>
  </view>

  <view class="form-card">
    <view class="field">
      <text class="label">饮品名称 <text class="required">*</text></text>
      <input
        class="input"
        placeholder="例如：生椰拿铁"
        value="{{coffeeName}}"
        maxlength="100"
        bindinput="onCoffeeNameInput"
      />
    </view>

    <view class="field">
      <text class="label">品牌</text>
      <input
        class="input"
        placeholder="例如：瑞幸 / 星巴克"
        value="{{brand}}"
        maxlength="100"
        bindinput="onBrandInput"
      />
    </view>

    <view class="field">
      <text class="label">容量</text>
      <view class="chip-row">
        <view
          wx:for="{{capacityOptions}}"
          wx:key="*this"
          class="chip {{capacity === item ? 'active' : ''}}"
          data-value="{{item}}"
          bindtap="onSelectCapacity"
        >{{item}}</view>
      </view>
    </view>

    <view class="field">
      <text class="label">甜度</text>
      <view class="chip-row">
        <view
          wx:for="{{sweetnessOptions}}"
          wx:key="*this"
          class="chip {{sweetness === item ? 'active' : ''}}"
          data-value="{{item}}"
          bindtap="onSelectSweetness"
        >{{item}}</view>
      </view>
    </view>

    <view class="field">
      <text class="label">冰度</text>
      <view class="chip-row">
        <view
          wx:for="{{iceOptions}}"
          wx:key="*this"
          class="chip {{iceLevel === item ? 'active' : ''}}"
          data-value="{{item}}"
          bindtap="onSelectIce"
        >{{item}}</view>
      </view>
    </view>

    <view class="field">
      <text class="label">评分</text>
      <view class="rating-row">
        <view
          wx:for="{{ratingStars}}"
          wx:key="*this"
          class="star {{rating >= item ? 'on' : ''}}"
          data-value="{{item}}"
          bindtap="onSelectRating"
        >★</view>
      </view>
    </view>

    <view class="field">
      <text class="label">价格（元）</text>
      <input
        class="input"
        type="digit"
        placeholder="例如：18.00"
        value="{{price}}"
        bindinput="onPriceInput"
      />
    </view>

    <view class="field">
      <text class="label">图片</text>
      <view class="image-area" bindtap="onChooseImage">
        <image wx:if="{{imageUrl}}" class="preview" src="{{imageUrl}}" mode="aspectFill"></image>
        <view wx:else class="image-placeholder">
          <text class="plus">+</text>
          <text class="hint">添加照片</text>
        </view>
      </view>
      <text wx:if="{{imageUrl}}" class="clear-image" bindtap="onClearImage">清除图片</text>
    </view>
  </view>

  <button class="save-btn" loading="{{saving}}" disabled="{{saving}}" bindtap="onSave">
    {{isEdit ? '保存修改' : '保存记录'}}
  </button>
</view>

<view class="page loading-page" wx:else>
  <text class="loading-text">加载中...</text>
</view>
