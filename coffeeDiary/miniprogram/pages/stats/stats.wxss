.page {
  min-height: 100vh;
  padding: 40rpx 32rpx calc(120rpx + env(safe-area-inset-bottom));
  background: #f7f3ef;
  box-sizing: border-box;
}

.header {
  margin-bottom: 48rpx;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  color: #3d2b1f;
}

.subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #9a8b7e;
}

.card-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.stat-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 36rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(111, 78, 55, 0.08);
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #6f4e37;
  line-height: 1.2;
}

.stat-label {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9a8b7e;
}

.empty-tip {
  margin-top: 80rpx;
  text-align: center;
  font-size: 26rpx;
  color: #b5a89c;
}
