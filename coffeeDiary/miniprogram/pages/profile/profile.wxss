.page {
  min-height: 100vh;
  padding: 40rpx 32rpx calc(120rpx + env(safe-area-inset-bottom));
  background: #f7f3ef;
  box-sizing: border-box;
}

.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #6f4e37 0%, #8b6347 100%);
  border-radius: 24rpx;
  padding: 28rpx 28rpx 28rpx 12rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(111, 78, 55, 0.25);
  overflow: visible;
  gap: 24rpx;
}

.avatar-wrap {
  width: 104rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.avatar-btn {
  padding: 0 !important;
  margin: 0 !important;
  width: 104rpx !important;
  height: 104rpx !important;
  min-width: 104rpx !important;
  max-width: 104rpx !important;
  min-height: 104rpx !important;
  max-height: 104rpx !important;
  border-radius: 50%;
  background: transparent !important;
  border: none !important;
  line-height: 0 !important;
  font-size: 0;
  overflow: hidden;
  display: block;
  box-sizing: border-box;
  position: relative;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  background: #ffffff;
  box-sizing: border-box;
  display: block;
  overflow: hidden;
}

.user-info {
  flex: 1;
  margin-left: 0;
  padding-left: 12rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  box-sizing: border-box;
}

.nickname-input {
  height: 48rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
}

.desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
}

.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  height: 88rpx;
  padding: 0;
  line-height: 1;
  border-radius: 44rpx;
  background: #ffffff;
  color: #6f4e37;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(111, 78, 55, 0.08);
}

.login-btn::after {
  border: none;
}

.login-btn[disabled] {
  opacity: 0.7;
}

.menu-list {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(111, 78, 55, 0.08);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid #f0ebe6;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-label {
  font-size: 30rpx;
  color: #3d2b1f;
}

.menu-arrow {
  font-size: 36rpx;
  color: #c4b8ad;
}
