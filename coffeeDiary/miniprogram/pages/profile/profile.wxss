.page {
  min-height: 100vh;
  padding: 40rpx 32rpx calc(120rpx + env(safe-area-inset-bottom));
  background: #f7f3ef;
  box-sizing: border-box;
}

.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #6f4e37 0%, #8b6347 100%);
  border-radius: 24rpx;
  padding: 48rpx 36rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(111, 78, 55, 0.25);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  background: #ffffff;
}

.user-info {
  margin-left: 28rpx;
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
}

.desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
}

.menu-list {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(111, 78, 55, 0.08);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid #f0ebe6;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-label {
  font-size: 30rpx;
  color: #3d2b1f;
}

.menu-arrow {
  font-size: 36rpx;
  color: #c4b8ad;
}
