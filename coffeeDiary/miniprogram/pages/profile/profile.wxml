<view class="page">
  <view class="user-card">
    <view class="avatar-wrap">
      <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image class="avatar" src="{{avatarUrl}}" mode="aspectFill"></image>
      </button>
    </view>
    <view class="user-info">
      <input
        class="nickname-input"
        type="nickname"
        placeholder="填写昵称"
        value="{{nickName}}"
        maxlength="64"
        bindblur="onNicknameBlur"
        bindinput="onNicknameInput"
      />
      <text class="desc">{{isLoggedIn ? '已登录，可以开始记录咖啡' : '登录后同步你的咖啡日记'}}</text>
    </view>
  </view>

  <button class="login-btn" loading="{{loggingIn}}" disabled="{{loggingIn}}" bindtap="onLogin">
    {{isLoggedIn ? '更新资料' : '微信登录'}}
  </button>

  <view class="menu-list">
    <view class="menu-item">
      <text class="menu-label">我的记录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item">
      <text class="menu-label">偏好设置</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item">
      <text class="menu-label">关于咖啡日记</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>
