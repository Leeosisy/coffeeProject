.page {
  min-height: 100vh;
  padding: 40rpx 32rpx calc(120rpx + env(safe-area-inset-bottom));
  background: #f7f3ef;
  box-sizing: border-box;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.calendar {
  display: block;
  margin-bottom: 32rpx;
}

.greeting {
  flex: 1;
  font-size: 44rpx;
  font-weight: 600;
  color: #3d2b1f;
}

.today-logo {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e8dfd6;
  flex-shrink: 0;
  margin-left: 24rpx;
}

.today-logo:active {
  opacity: 0.85;
}

.today-logo.active {
  background: linear-gradient(135deg, #6f4e37 0%, #8b6347 100%);
}

.today-num {
  font-size: 34rpx;
  font-weight: 600;
  color: #6f4e37;
  line-height: 1;
}

.today-logo.active .today-num {
  color: #ffffff;
}

.action-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  margin-bottom: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(111, 78, 55, 0.1);
}

.action-card:active {
  opacity: 0.85;
}

.action-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6f4e37 0%, #8b6347 100%);
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.action-text {
  margin-left: 28rpx;
  display: flex;
  flex-direction: column;
}

.action-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3d2b1f;
}

.action-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9a8b7e;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #3d2b1f;
  margin-bottom: 24rpx;
}

.empty-tip {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 60rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #b5a89c;
  box-shadow: 0 4rpx 16rpx rgba(111, 78, 55, 0.06);
}
