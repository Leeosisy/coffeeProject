<!--index.wxml-->
<view class="page">
  <view class="header">
    <text class="greeting">今天喝了什么</text>
    <view class="today-logo {{isToday ? 'active' : ''}}" bindtap="onGoToday">
      <text class="today-num">{{todayDay}}</text>
    </view>
  </view>

  <calendar class="calendar" value="{{selectedDate}}" bind:select="onDateSelect"></calendar>

  <view class="action-card" bindtap="onAddRecord">
    <view class="action-icon">+</view>
    <view class="action-text">
      <text class="action-title">记录一杯咖啡 | 茶</text>
      <text class="action-desc">风味、品种、产地...</text>
    </view>
  </view>

  <view class="section">
    <text class="section-title">{{dateLabel}}的记录</text>

    <view wx:if="{{loadingRecords}}" class="empty-tip">
      <text>加载中...</text>
    </view>

    <block wx:elif="{{records.length}}">
      <view
        class="record-item"
        wx:for="{{records}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onEditRecord"
      >
        <view class="record-main">
          <text class="record-name">{{item.coffee_name}}</text>
          <text class="record-meta" wx:if="{{item.brand}}">{{item.brand}}</text>
          <view class="record-tags">
            <text wx:if="{{item.capacity}}" class="tag">{{item.capacity}}</text>
            <text wx:if="{{item.sweetness}}" class="tag">{{item.sweetness}}</text>
            <text wx:if="{{item.ice_level}}" class="tag">{{item.ice_level}}</text>
          </view>
        </view>
        <view class="record-side">
          <text wx:if="{{item.rating}}" class="record-rating">{{item.rating}}分</text>
          <text wx:if="{{item.price}}" class="record-price">¥{{item.price}}</text>
          <text class="record-edit">编辑</text>
        </view>
      </view>
    </block>

    <view wx:else class="empty-tip">
      <text>这一天还没有记录，点击上方开始记录</text>
    </view>
  </view>
</view>
